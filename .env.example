# Copy to .env.local and fill in.
#
# Leave VITE_API_URL blank to run the site with no backend at all — content
# comes from src/data/content.js and the assistant uses its built-in replies.
#
# In development you can leave this blank and still reach the API: vite.config.js
# proxies /api to VITE_PROXY_TARGET (default http://localhost:8787).
VITE_API_URL=

# Only used by the dev proxy.
VITE_PROXY_TARGET=http://localhost:8787
