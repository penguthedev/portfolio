# Copy to server/.env and fill in. Never commit the real .env.

# Required for the assistant. Without it /api/chat returns 503 and the site
# quietly falls back to its built-in replies.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Haiku is fast and cheap, which suits short portfolio Q&A.
# Swap for claude-sonnet-5 if you want longer, more nuanced answers.
CLAUDE_MODEL=claude-haiku-4-5-20251001

PORT=8787

# Comma-separated. Add your deployed domain before going live.
ALLOWED_ORIGINS=http://localhost:5173
